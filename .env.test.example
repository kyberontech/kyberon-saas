# Variáveis de ambiente para o serviço "kyberon-test" no EasyPanel
# Copie estes nomes na aba Environment do app kyberon-test — NÃO commitar valores reais.

# String de conexão do serviço "kyberon-db-test" (Postgres separado do de produção).
# Dentro da rede interna do EasyPanel, o host é o nome do serviço de banco de dados.
DATABASE_URL=postgresql://usuario:senha@kyberon-db-test:5432/kyberon_test

# Gere um valor novo e diferente do usado em produção, ex: openssl rand -base64 32
NEXTAUTH_SECRET=

NODE_ENV=production
